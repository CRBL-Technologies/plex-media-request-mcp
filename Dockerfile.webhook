FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/opt/data \
    PLEX_MEDIA_REQUEST_WEBHOOK_HOST=0.0.0.0 \
    PLEX_MEDIA_REQUEST_WEBHOOK_PORT=18081

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY media_request_server.py ./
COPY radarr_webhook_bridge.py ./

RUN mkdir -p /opt/data/state && chown -R app:app /opt/data /app

USER app

EXPOSE 18081

ENTRYPOINT ["python", "/app/radarr_webhook_bridge.py"]
