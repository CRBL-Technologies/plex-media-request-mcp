# Copy this file to a deployment-only .env and fill in release metadata.  Keep
# the copy outside the repository and never put secret values in Compose text.
# Every image variable below is required and must be repository@sha256:<64 hex>.

MEDIA_SERVER_MCP_IMAGE=
MEDIA_COMPANION_IMAGE=
MEDIA_DASHBOARD_IMAGE=
HERMES_MEDIA_IMAGE=

# Immutable release provenance (the manifest validator checks these formats).
MEDIA_COMPANION_COMMIT=
MEDIA_DASHBOARD_COMMIT=
HERMES_BASE_IMAGE=
HERMES_BASE_COMMIT=
HERMES_MEDIA_COMMIT=
COMPOSE_SHA256=
CONFIG_SHA256=
MIGRATION_CHECKSUMS_SHA256=
UPSTREAM_SBOM_SHA256=
COMPANION_SBOM_SHA256=
DASHBOARD_SBOM_SHA256=
HERMES_SBOM_SHA256=

# Canonical host files.  These are paths, not secret contents.
MEDIA_ROOT=/volume2/docker/hermes-media
UPSTREAM_ENV_FILE=/volume2/docker/hermes-media/secrets/upstream.env
COMPANION_ENV_FILE=/volume2/docker/hermes-media/secrets/companion.env
HERMES_DATA_DIR=/volume2/docker/hermes-media/data
COMPANION_STATE_DIR=/volume2/docker/hermes-media/data/state
ACTOR_SIGNING_KEY_FILE=/volume2/docker/hermes-media/secrets/actor-signing.key
DASHBOARD_API_KEY_FILE=/volume2/docker/hermes-media/secrets/dashboard-api.key
DASHBOARD_AUTH_ENV_FILE=/volume2/docker/hermes-media/secrets/dashboard-auth.env

# The files above are created and permissioned by the operator, outside Git:
#   .env                  native Hermes Telegram policy source (inside data/)
#   upstream.env          provider URL selectors/keys and MCP_AUTH_TOKEN
#   companion.env         companion settings and loopback webhook capability
#   actor-signing.key     256-bit actor-signing key (0600)
#   dashboard-auth.env    scrypt password hash and allowed origins
#   dashboard-api.key     separate dashboard API key (0600)
# The Hermes data/.env must contain TELEGRAM_ALLOWED_USERS and, when admin
# tool visibility is enabled, one TELEGRAM_ADMIN_USERS assignment (numeric
# IDs, comma-separated). The private helper reads only those bounded policy
# assignments; it never returns dotenv values or tokens.
# Do not commit any populated copy of these files.
# The companion reads approved URL selectors from its mounted upstream.env;
# keep provider URLs out of companion.env so the upstream file is never a
# Docker env_file and credentials remain available only through *_FILE paths.
