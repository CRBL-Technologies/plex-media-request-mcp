# Portainer stack variables. Values are image references and host paths only;
# application configuration lives exclusively in gateway.env.
MEDIA_GATEWAY_IMAGE=
HERMES_MEDIA_IMAGE=
HERMES_DATA_DIR=/volume2/docker/hermes-media/data
GATEWAY_STATE_DIR=/volume2/docker/hermes-media/data/state
UPSTREAM_ENV_FILE=/volume2/docker/hermes-media/secrets/upstream.env
GATEWAY_CONFIG_FILE=/volume2/docker/hermes-media/secrets/gateway.env
GATEWAY_TOKEN_FILE=/volume2/docker/hermes-media/secrets/gateway.key
DASHBOARD_PASSWORD_HASH_FILE=/volume2/docker/hermes-media/secrets/dashboard-password.hash
DASHBOARD_SESSION_KEY_FILE=/volume2/docker/hermes-media/secrets/dashboard-session.key
PLEX_WEBHOOK_TOKEN_FILE=/volume2/docker/hermes-media/secrets/plex-webhook.key
