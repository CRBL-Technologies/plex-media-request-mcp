# syntax=docker/dockerfile:1.7
#
# Supply PYTHON_BASE_IMAGE as a fully resolved repository@sha256:<digest>
# reference for every release build.  No mutable base tag is selected here.

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS runtime

ARG SOURCE_COMMIT
ARG PYTHON_BASE_IMAGE

RUN python -c 'import re,sys; sys.exit(0 if re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", sys.argv[1]) else 1)' "$PYTHON_BASE_IMAGE"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HOME=/opt/data \
    UMASK=0077

WORKDIR /app

RUN groupadd --gid 1000 dashboard \
    && useradd --uid 1000 --gid 1000 --home-dir /opt/data \
       --shell /usr/sbin/nologin --no-create-home dashboard \
    && mkdir -p /opt/data /run/media-secrets \
    && chown -R 1000:1000 /opt/data /run/media-secrets /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes \
       --disable-pip-version-check -r /app/requirements.txt \
    && (python -m pip cache purge >/dev/null 2>&1 || true)

COPY --chown=1000:1000 src /app/src

LABEL org.opencontainers.image.title="CRBL media request dashboard" \
      org.opencontainers.image.source="https://github.com/crbl-technologies/plex-media-request-mcp" \
      org.opencontainers.image.revision="$SOURCE_COMMIT"

USER 1000:1000

EXPOSE 18082

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18082/healthz', timeout=3).read(1)"

ENTRYPOINT ["python", "-m", "media_dashboard"]
