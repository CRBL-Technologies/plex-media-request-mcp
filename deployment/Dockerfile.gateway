# syntax=docker/dockerfile:1.7
ARG PYTHON_BASE_IMAGE
FROM 1password/op:2.41.1@sha256:86c9f8c1961a87f4bcf4780f15c564c21f76ba5822635614b6b6d8a1e22fdbea AS onepassword
FROM ${PYTHON_BASE_IMAGE} AS runtime

ARG PYTHON_BASE_IMAGE
ARG SOURCE_COMMIT

RUN python -c 'import re,sys; sys.exit(0 if re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", sys.argv[1]) else 1)' "$PYTHON_BASE_IMAGE"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HOME=/opt/data \
    UMASK=0077

WORKDIR /app
RUN groupadd --gid 1000 media \
    && useradd --uid 1000 --gid 1000 --home-dir /opt/data --shell /usr/sbin/nologin media \
    && mkdir -p /opt/data/state /run/media-secrets \
    && chown -R 1000:1000 /opt/data /run/media-secrets /app

COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /app/requirements.txt
COPY src /app/src

LABEL org.opencontainers.image.source="https://github.com/CRBL-Technologies/plex-media-request-mcp" \
      org.opencontainers.image.revision="$SOURCE_COMMIT"

USER 1000:1000
EXPOSE 18082
ENTRYPOINT ["python", "-m", "media_gateway.app"]

# Explicit opt-in image target. The default/public target below keeps the
# original entrypoint and file-based configuration contract.
FROM runtime AS managed
COPY --from=onepassword /usr/local/bin/op /usr/local/bin/op
ENTRYPOINT ["python", "-m", "media_gateway.managed_start"]

FROM runtime AS gateway
