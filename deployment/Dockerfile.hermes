# syntax=docker/dockerfile:1.7
ARG HERMES_BASE_IMAGE
FROM 1password/op:2.41.1@sha256:86c9f8c1961a87f4bcf4780f15c564c21f76ba5822635614b6b6d8a1e22fdbea AS onepassword
FROM ${HERMES_BASE_IMAGE} AS runtime

ARG HERMES_BASE_IMAGE
ARG SOURCE_COMMIT
RUN /opt/hermes/.venv/bin/python -c 'import re,sys; sys.exit(0 if re.fullmatch(r"[^\s@]+@sha256:[0-9a-f]{64}", sys.argv[1]) else 1)' "$HERMES_BASE_IMAGE"

ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    PYTHONPATH=/opt/hermes
WORKDIR /opt/hermes

COPY deployment/hermes-requirements.txt /tmp/crbl-hermes-requirements.txt
# Use the image's pinned installer and its own lock-aware dependency check.
# Only security overrides already recorded by the vendor lock are accepted.
RUN /opt/hermes/.venv/bin/python - <<'PY'
import subprocess
import sys
from pathlib import Path

from pm import uv_launcher
from pm.pip_check import unexpected_incompatibilities

uv = uv_launcher("uv")
assert uv is not None, "pinned Hermes installer is unavailable"
subprocess.run([
    str(uv), "pip", "install", "--python", sys.executable,
    "--no-cache", "--no-deps", "--require-hashes", "-r", "/tmp/crbl-hermes-requirements.txt",
], cwd="/tmp", check=True)
check = subprocess.run(
    [str(uv), "pip", "check", "--python", sys.executable],
    cwd="/tmp", capture_output=True, text=True,
)
report = check.stdout + check.stderr
if check.returncode and unexpected_incompatibilities(report, Path("/opt/hermes/uv.lock")) != []:
    raise SystemExit(report)
import ddgs
PY

# Native launchers replace PYTHONPATH with the immutable install root and the
# selected dependency generation. Keep CRBL packages in that install root.
COPY src /opt/hermes
COPY deployment/hermes/plugin /opt/hermes/plugins/platforms/zzzz-crbl-media
COPY --chmod=0755 deployment/hermes/03-crbl-media /etc/cont-init.d/03-crbl-media

RUN /opt/hermes/.venv/bin/python -c 'import httpx; import hermes_media.plugin' \
    && /opt/hermes/.venv/bin/python -c 'from hermes_media.soul import SOUL_MD; assert SOUL_MD.strip()' \
    && test -f /opt/hermes/plugins/platforms/zzzz-crbl-media/plugin.yaml

LABEL org.opencontainers.image.source="https://github.com/CRBL-Technologies/plex-media-request-mcp" \
      org.opencontainers.image.revision="$SOURCE_COMMIT"

CMD ["gateway", "run"]

FROM runtime AS managed
COPY --from=onepassword /usr/local/bin/op /usr/local/bin/op
COPY --chmod=0755 deployment/hermes/016-crbl-managed /etc/cont-init.d/016-crbl-managed
ENV HERMES_MANAGED_DIR=/run/hermes-managed

FROM runtime AS hermes
