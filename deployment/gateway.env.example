# Copy to /volume2/docker/hermes-media/secrets/gateway.env.
# This is the only source for gateway runtime settings.
MEDIA_GATEWAY_HOST=0.0.0.0
MEDIA_GATEWAY_PORT=18082
MEDIA_GATEWAY_DB_PATH=/opt/data/state/gateway.sqlite3
MEDIA_GATEWAY_POLICY_FILE=/opt/hermes-data/.env
MEDIA_GATEWAY_TOKEN_FILE=/run/media-secrets/gateway.key
MEDIA_GATEWAY_UPSTREAM_URL=http://media-server-mcp:3000
MEDIA_GATEWAY_UPSTREAM_TOKEN_FILE=/run/media-secrets/upstream.env
MEDIA_GATEWAY_DASHBOARD_PASSWORD_HASH_FILE=/run/media-secrets/dashboard-password.hash
MEDIA_GATEWAY_DASHBOARD_SESSION_KEY_FILE=/run/media-secrets/dashboard-session.key
MEDIA_GATEWAY_PLEX_WEBHOOK_TOKEN_FILE=/run/media-secrets/plex-webhook.key
MEDIA_GATEWAY_SECURE_COOKIES=false
MEDIA_GATEWAY_RADARR_PROFILE_ID=replace-me
MEDIA_GATEWAY_RADARR_ROOT=/data/movies
MEDIA_GATEWAY_RADARR_TAG_IDS=
MEDIA_GATEWAY_SONARR_PROFILE_ID=replace-me
MEDIA_GATEWAY_SONARR_ANIME_PROFILE_ID=replace-me
MEDIA_GATEWAY_SONARR_ROOT=/data/tv
MEDIA_GATEWAY_SONARR_TAG_IDS=
MEDIA_GATEWAY_PLEX_MACHINE_ID=replace-me
MEDIA_GATEWAY_NOTIFICATION_DELAY_SECONDS=300
MEDIA_GATEWAY_TELEGRAM_IDENTITY_SYNC=true
