import os
import sys
import time
from pathlib import Path

import httpx
from media_gateway.constants import ADMIN_UPSTREAM_TOOLS, SHARED_TOOLS

url = os.environ["CRBL_MEDIA_GATEWAY_URL"].rstrip("/") + "/api/schema"
token = Path(os.environ["CRBL_MEDIA_GATEWAY_TOKEN_FILE"]).read_text().strip()
expected = {name: "shared" for name in SHARED_TOOLS}
expected.update({name: "admin" for name in ADMIN_UPSTREAM_TOOLS})
for _ in range(30):
    try:
        response = httpx.get(url, headers={"Authorization": f"Bearer {token}"}, timeout=5)
        response.raise_for_status()
        tools = response.json().get("tools")
        manifest = (
            {
                item.get("name"): item.get("scope")
                for item in tools
                if isinstance(item, dict)
                and isinstance(item.get("name"), str)
                and item.get("scope") in {"shared", "admin"}
            }
            if isinstance(tools, list)
            else {}
        )
        if manifest == expected and len(tools) == len(expected):
            sys.exit(0)
    except Exception:
        pass
    time.sleep(2)
raise SystemExit("CRBL media gateway contract is unavailable")
PY

