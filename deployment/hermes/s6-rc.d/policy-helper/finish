#!/command/with-contenv sh
set -eu

# $1 is the run exit code and $2 is the terminating signal.  Invalid
# configuration is a permanent failure so s6 cannot hot-loop while the policy
# key/path is wrong.  Ordinary crashes are restarted by s6.  A signal during
# container shutdown is also permanent; stage 3 owns the final teardown.
if [ "${2:-0}" != "0" ]; then
    exit 125
fi
case "${1:-1}" in
    2|78)
        exit 125
        ;;
    *)
        exit 0
        ;;
esac
